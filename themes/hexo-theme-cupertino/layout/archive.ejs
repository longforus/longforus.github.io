<%
  var groups = {};
  page.posts.each(function (post) {
    var year = post.date.year();
    if (!groups[year]) groups[year] = [];
    groups[year].push(post);
  });
  var years = Object.keys(groups).sort(function (a, b) { return b - a; });
  var isPartialArchive = !!(page.year || page.month);
  var archiveCount = isPartialArchive ? page.posts.length : site.posts.length;
%>
<div class="container archive-container">
    <header class="page-header">
        <h1 class="page-title"><%= __('archive') %></h1>
        <p class="page-subtitle"><%= isPartialArchive ? '本页 ' : '共 ' %><%= archiveCount %> 篇笔记</p>
    </header>

    <% years.forEach(function (year) { %>
    <section class="archive-year">
        <h2 class="archive-year-title"><%= year %></h2>
        <ul class="archive-list">
            <% groups[year].forEach(function (post) { %>
            <li>
                <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'MM-DD') %></time>
                <a href="<%- url_for(post.path) %>"><%= post.title %></a>
                <% if (post.categories && post.categories.length) { %>
                <span class="archive-category"><%= post.categories.first().name %></span>
                <% } %>
            </li>
            <% }) %>
        </ul>
    </section>
    <% }) %>
</div>
