<div class="container page-container">
    <header class="page-header">
        <h1 class="page-title"><%= page.title %></h1>
        <% if (page.description) { %>
        <p class="page-subtitle"><%= page.description %></p>
        <% } %>
    </header>
    <div class="content page-content">
        <%- page.content %>
    </div>
</div>
