<%
  var plainText = page.content.replace(/<[^>]*>/g, '');
  var charCount = plainText.replace(/\s/g, '').length;
  var readMinutes = Math.max(1, Math.ceil(charCount / 350));
  var tocHtml = toc(page.content, { list_number: false, max_depth: 3 });
  var updatedText = date(page.updated, 'YYYY-MM-DD');
  var dateText = date(page.date, 'YYYY-MM-DD');
%>
<article class="post">
    <div class="meta">
        <div class="post-meta">
            <span class="post-date"><%= dateText %></span>
            <% if (updatedText && updatedText !== dateText) { %>
            <span class="dot">·</span>
            <span class="post-updated">更新于 <%= updatedText %></span>
            <% } %>
            <span class="dot">·</span>
            <span class="post-reading"><%= readMinutes %> 分钟阅读</span>
        </div>

        <h1 class="title"><%= page.title %></h1>

        <% if ((page.categories && page.categories.length) || (page.tags && page.tags.length)) { %>
        <div class="post-taxonomy">
            <% page.categories.each(function (category) { %>
            <a class="chip chip-category" href="<%- url_for(category.path) %>"><%= category.name %></a>
            <% }) %>
            <% page.tags.each(function (tag) { %>
            <a class="chip" href="<%- url_for(tag.path) %>"># <%= tag.name %></a>
            <% }) %>
        </div>
        <% } %>
    </div>

    <div class="divider"></div>

    <% if (tocHtml) { %>
    <details class="toc-card">
        <summary>目录</summary>
        <%- tocHtml %>
    </details>
    <% } %>

    <div class="content">
        <%- page.content %>
    </div>

    <div class="about">
        <h2>关于本文</h2>
        <p>本文作者 <%- config.author %>，采用 <a href="<%- theme.license_link %>" target="_blank" rel="noopener"><%- theme.license %></a> 许可协议。转载请注明出处。</p>
    </div>

    <% if (!page.no_comments) { %>
        <% if (config.waline) { %>
        <div class="container">
            <div id="waline"></div>
            <script>
                new Waline({
                    el: "#waline",
                    <% for (const i in config.waline) { %>
                    <%- i %>: <%- config.waline[i] %>,
                    <% } %>
                });
            </script>
        </div>
        <% } %>
    <% } %>
</article>
