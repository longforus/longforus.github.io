<div class="container">
    <% if (page.path == "index.html") { %>
    <section class="hero">
        <div class="group">
            <p class="sub"><%= config.subtitle %></p>
            <h1 class="large"><%= config.description %></h1>
            <div class="hero-stats">
                <span><strong><%= site.posts.length %></strong> 篇笔记</span>
                <span><strong><%= site.categories.length %></strong> 个分类</span>
                <span><strong><%= site.tags.length %></strong> 个标签</span>
            </div>
        </div>
    </section>

    <h2 class="section-title"><%= __('latest_posts') %></h2>
    <% } %>

    <%- partial('_partial/post-list') %>

    <%- partial('_partial/paginator') %>
</div>
