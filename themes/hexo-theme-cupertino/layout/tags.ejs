<%
  var tags = site.tags.toArray().sort(function (a, b) { return b.length - a.length; });
%>
<div class="container page-container">
    <header class="page-header">
        <h1 class="page-title">标签</h1>
        <p class="page-subtitle">共 <%= tags.length %> 个标签</p>
    </header>

    <div class="tag-cloud">
        <% tags.forEach(function (tag) { %>
        <a class="chip chip-large" href="<%- url_for(tag.path) %>">
            # <%= tag.name %><span class="chip-count"><%= tag.length %></span>
        </a>
        <% }) %>
    </div>
</div>
