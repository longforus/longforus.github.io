<%
  var categories = site.categories.toArray().sort(function (a, b) { return b.length - a.length; });
%>
<div class="container page-container">
    <header class="page-header">
        <h1 class="page-title">分类</h1>
        <p class="page-subtitle">共 <%= categories.length %> 个分类</p>
    </header>

    <div class="category-grid">
        <% categories.forEach(function (category) { %>
        <a class="category-card" href="<%- url_for(category.path) %>">
            <span class="category-name"><%= category.name %></span>
            <span class="category-count"><%= category.length %> 篇</span>
        </a>
        <% }) %>
    </div>
</div>
