<nav id="theme-nav">
    <div class="inner">
        <a class="title" href="<%- url_for('/') %>"><%= theme.nav.title %></a>
        <div class="nav-arrow"></div>
        <div class="nav-items">
            <a class="nav-item nav-item-home" href="<%- url_for('/') %>"><%= __('home') %></a>
            <% for (const i in theme.nav.items) { %>
            <%
              const rawUrl = theme.nav.items[i];
              const isExternal = /^(https?:)?\/\//i.test(rawUrl) || /^mailto:/i.test(rawUrl);
              const href = isExternal ? rawUrl : url_for(rawUrl);
            %>
            <% if (i == 'GitHub' || i == 'github' || i == 'gh') { %>
            <a class="nav-item nav-item-github nav-item-icon" href="<%- href %>" target="_blank" rel="noopener" aria-label="GitHub">&nbsp;</a>
            <% } else if (i == 'Patreon' || i == 'patreon') { %>
            <a class="nav-item nav-item-patreon nav-item-icon" href="<%- href %>" target="_blank" rel="noopener" aria-label="Patreon">&nbsp;</a>
            <% } else if (i == 'CodePen' || i == 'codepen') { %>
            <a class="nav-item nav-item-codepen nav-item-icon" href="<%- href %>" target="_blank" rel="noopener" aria-label="CodePen">&nbsp;</a>
            <% } else { %>
            <a class="nav-item" href="<%- href %>"<%- isExternal ? ' target="_blank" rel="noopener"' : '' %>><%= i %></a>
            <% } %>
            <% } %>
        </div>
    </div>
</nav>
